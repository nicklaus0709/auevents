      "type": "string"
    },
    "galeria_titulo": {
      "type": "string"
    },
    "bonos_cta_titulo": {
      "type": "string"
    },
    "bonos_cta_texto": {
      "type": "string"
    },
    "eventos_titulo": {
      "type": "string"
    },
    "eventos_subtitulo": {
      "type": "string"
    },
    "gastronomia_titulo": {
      "type": "string"
    },
    "gastronomia_subtitulo": {
      "type": "string"
    },
    "alojamientos_titulo": {
      "type": "string"
    },
    "alojamientos_subtitulo": {
      "type": "string"
    },
    "bonos_titulo": {
      "type": "string"
    },
    "bonos_subtitulo": {
      "type": "string"
    },
    "bonos_montos": {
      "type": "string"
    },
    "contacto_titulo": {
      "type": "string"
    },
    "contacto_subtitulo": {
      "type": "string"
    },
    "footer_texto": {
      "type": "string"
    },
    "footer_ubicacion": {
      "type": "string"
    },
    "footer_links": {
      "type": "string"
    },
    "chat_saludo": {
      "type": "string"
    },
    "ambiente_activo": {
      "type": "boolean",
      "default": true
    },
    "ambiente_logo": {
      "type": "string"
