{
  "name": "Evento",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "historia": {
      "type": "string"
    },
    "nosotros": {
      "type": "string"
    },
    "lema": {
      "type": "string",
      "description": "Lema del evento, ej: AMOR A SU PUEBLO"
    },
    "periodo": {
      "type": "string",
      "description": "Cuándo se realiza, en texto libre"
    },
    "lugar": {
      "type": "string",
      "description": "Dónde se realiza"
    },
    "telefono": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "mostrar_bonos": {
      "type": "boolean",
      "default": true
    },
    "mostrar_chat": {
      "type": "boolean",
      "default": true
    },
    "hero_eyebrow": {
      "type": "string"
    },
