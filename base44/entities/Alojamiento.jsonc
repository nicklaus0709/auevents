{
  "name": "Alojamiento",
  "type": "object",
  "properties": {
    "evento_id": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "description": "Hotel, hostería, cabañas, camping, hospedaje, etc."
    },
    "direccion": {
      "type": "string"
    },
    "maps_url": {
      "type": "string",
      "description": "Link de Google Maps"
    },
    "telefono": {
      "type": "string"
    },
    "imagen_url": {
      "type": "string"
    },
    "orden": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "evento_id",
    "nombre"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
